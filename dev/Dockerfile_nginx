FROM nginx:1.31.8-alpine-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN n=0; \
    until apk update && apk add --no-cache iputils procps openssl; do \
      n=$((n+1)); \
      if [ "$n" -ge 5 ]; then echo "apk failed after $n attempts" >&2; exit 1; fi; \
      echo "apk failed (attempt $n), retrying..." >&2; \
      sleep 5; \
    done && \
    rm -rf /var/cache/apk/*

WORKDIR /etc/nginx/

COPY proxy/ssl.conf /etc/ssl/openssl.cnf

RUN openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -config /etc/ssl/openssl.cnf -extensions v3_ca \
    -keyout cert.key -out cert.crt

COPY proxy/default.conf /etc/nginx/conf.d/default.conf
