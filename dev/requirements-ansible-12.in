# Human-maintained source file for ansible-core 2.19 + pytest-testinfra dependencies.
# Edit this file to update versions — do NOT edit requirements-ansible-12.txt directly.
#
# Uses ansible-core (not the full ansible bundle) because the community ansible
# package is not available to the CI reader account in Artifactory.
# ansible-core==2.19.x is the same engine that shipped with ansible==12.x.
#
# To regenerate requirements-ansible-12.txt with pinned versions and hashes, run
# (requires ~/.pip/pip.conf with Artifactory credentials):
#
#   docker run --rm \
#     -v "${HOME}/.pip/pip.conf:/root/.pip/pip.conf:ro" \
#     -v "$(pwd)/dev:/work" python:3.12-slim /bin/sh -c "
#       pip install pip-tools==7.6.2 &&
#       pip-compile --generate-hashes --no-emit-index-url \
#         --output-file /work/requirements-ansible-12.txt \
#         /work/requirements-ansible-12.in
#     "
#
# Note: compiled with python:3.12-slim; abi3/pure-Python wheels make this
# compatible with both Python 3.12 and 3.13 runtimes.
#
ansible-core==2.19.*
pytest-testinfra==10.2.2
