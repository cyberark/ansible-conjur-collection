#!/bin/bash

set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"
export COLLECTION_VERSION="$(cat "$REPO/VERSION" | cut -d'-' -f1)"
TOP_LEVEL_DIR="$(cd "$(dirname "$BASH_SOURCE")"; pwd)/.."

source "$REPO/dev/util.sh"
require_pip_conf

pushd "$TOP_LEVEL_DIR" >/dev/null

  # Stage 1: build a temp image with ansible-core pre-installed.
  # pip.conf is injected via BuildKit --secret: it is only visible during the
  # RUN step in ci/Dockerfile.build and is never stored in any image layer.
  DOCKER_BUILDKIT=1 docker build \
    --secret id=pip_conf,src="${PIP_CONF}" \
    --no-cache \
    -f ci/Dockerfile.build \
    -t ansible-build-tmp:latest \
    .

  # Stage 2: build the collection artifact — no pip.conf present at runtime.
  # /dev/null shadows the repo-root pip.conf that would otherwise be accessible
  # inside the container via the /collection volume mount.
  docker run --rm -t \
    -v "$TOP_LEVEL_DIR:/collection" \
    -v /dev/null:/collection/pip.conf:ro \
    ansible-build-tmp:latest /bin/bash -c "
      # Verify and replace the version in the galaxy.yml file
      if [[ -n \"$COLLECTION_VERSION\" ]] && ! grep -q \"version: '$COLLECTION_VERSION'\" /collection/galaxy.yml; then
        sed -i 's/version: \".*\"/version: \"$COLLECTION_VERSION\"/' /collection/galaxy.yml
      fi
      ansible-galaxy collection build --force --output /collection/. /collection
    "

  # Clean up the temp build image.
  docker rmi ansible-build-tmp:latest || true

  # pip.conf holds Artifactory credentials and must never be shipped in the artifact.
  for artifact in cyberark-conjur-*.tar.gz; do
    if tar -tzf "$artifact" | grep -qE '(^|/)pip\.conf'; then
      echo "ERROR: $artifact contains a pip.conf file. Check build_ignore in galaxy.yml." >&2
      rm -f "$artifact"
      exit 1
    fi
  done

popd >/dev/null
