# Human-maintained source file for test dependencies.
# Edit this file to add/update packages — do NOT edit requirements.txt directly.
#
# To regenerate requirements.txt with pinned versions and hashes, run:
#
#   docker run --rm -v "$(pwd)/tests/unit:/work" python:3.12-slim /bin/sh -c "
#     pip install pip-tools==7.6.2 &&
#     pip-compile --generate-hashes --output-file /work/requirements.txt /work/requirements.in
#   "
#
mock
pytest
pytest-mock
pytest-xdist
pytest-forked
cryptography
pyyaml  # required by the collection loader (only needed for collections)
coverage

bcrypt ; python_version >= '3.8'  # controller only
passlib ; python_version >= '3.8'  # controller only
pexpect ; python_version >= '3.8'  # controller only
pytz
pywinrm ; python_version >= '3.8'  # controller only
unittest2 ; python_version < '2.7'
